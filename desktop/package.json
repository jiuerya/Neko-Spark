{
  "name": "gallery-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Neko_Spark - 把安卓手机相册备份到电脑，并以手机相册的方式浏览",
  "author": "Neko_Spark",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "npm run typecheck && npm run build && npm run test:api",
    "test:api": "node scripts/api-contract.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:nsis": "electron-vite build && electron-builder --win nsis",
    "dist:portable": "electron-vite build && electron-builder --win portable"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "exifr": "^7.1.3",
    "libheif-js": "^1.23.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.4"
  }
}
